# ===== AI Service (ai-service/.env) =====
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
# model cadangan saat utama kena rate limit (urut, dipisah koma)
GROQ_FALLBACK_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b,llama-3.1-8b-instant
# voice note (Whisper di Groq); bisa di-toggle runtime via /admin/config/voice
VOICE_ENABLED=true
STT_MODELS=whisper-large-v3-turbo,whisper-large-v3

QDRANT_URL=http://localhost:6003
REDIS_URL=redis://localhost:6004
QDRANT_COLLECTION=products

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

TOP_K=5

# Sumber data produk (API toko) + sinkronisasi
PRODUCTS_API_URL=https://shop.teknonusantara.net/api/products
PRODUCTS_API_PER_PAGE=50
SYNC_INTERVAL_MINUTES=30
# token utk POST /admin/sync (kosong = endpoint dimatikan)
ADMIN_TOKEN=

# Branding & guard
STORE_NAME=TokoEko
MAX_INPUT_CHARS=500
MAX_OUTPUT_CHARS=1500

# ===== WA Gateway (wa-gateway/.env) =====
AI_SERVICE_URL=http://localhost:6001
